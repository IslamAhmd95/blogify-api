DATABASE_URL=your-database-url-here
DATABASE_USER=root
DATABASE_PASSWORD="password"
DATABASE_DB="db name"
SECRET_KEY=your-secret-key-here
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30 # minutes
REFRESH_TOKEN_EXPIRE_DAYS=7 # days
REDIS_URL="redis://redis:6379/0"
COOKIE_SECURE=true # set false only for local http testing
COOKIE_SAMESITE="strict" # "none" if the frontend is on another domain (requires COOKIE_SECURE=true)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900 # seconds
